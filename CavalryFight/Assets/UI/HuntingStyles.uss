/* ==========================================
   Hunting Scene Styles
   ========================================== */

/* Root */
.root {
    flex-grow: 1;
    justify-content: space-between;
}

/* ==========================================
   HUD Panel
   ========================================== */

.hud-panel {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 20px 30px;
}

/* Role Badge */
.role-badge-container {
    margin-bottom: 15px;
}

.role-badge {
    font-size: 16px;
    padding: 8px 20px;
    border-radius: 5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.role--hunter {
    background-color: rgba(100, 200, 100, 0.8);
    color: white;
}

.role--wolf {
    background-color: rgba(150, 100, 50, 0.8);
    color: white;
}

/* Player Stats */
.player-stats-panel {
    background-color: rgba(0, 0, 0, 0.6);
    padding: 15px 20px;
    border-radius: 10px;
    min-width: 200px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.stat-row:last-child {
    margin-bottom: 0;
}

.stat-label {
    font-size: 18px;
    color: rgb(180, 180, 180);
    min-width: 80px;
}

.stat-value {
    font-size: 20px;
    color: white;
    -unity-font-style: bold;
    min-width: 60px;
    -unity-text-align: middle-right;
}

.stat-value--score {
    font-size: 28px;
    color: rgb(255, 215, 0);
}

/* Center Panel */
.center-panel {
    align-items: center;
}

.game-mode-badge {
    font-size: 16px;
    color: rgb(200, 200, 200);
    background-color: rgba(0, 0, 0, 0.6);
    padding: 8px 20px;
    border-radius: 5px;
    margin-bottom: 10px;
}

.timer-label {
    font-size: 48px;
    color: white;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 10px 30px;
    border-radius: 10px;
}

/* Team Score Panel */
.team-score-panel {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 15px 25px;
    border-radius: 10px;
}

.team-score {
    align-items: center;
    min-width: 100px;
}

.team-name {
    font-size: 14px;
    color: rgb(180, 180, 180);
    margin-bottom: 5px;
}

.team-score-value {
    font-size: 36px;
    -unity-font-style: bold;
}

.team-score--team0 .team-score-value {
    color: rgb(100, 150, 255);
}

.team-score--team1 .team-score-value {
    color: rgb(255, 100, 100);
}

.team-vs {
    font-size: 20px;
    color: rgb(150, 150, 150);
    margin: 0 20px;
}

/* ==========================================
   Stun Indicator
   ========================================== */

.stun-panel {
    position: absolute;
    left: 50%;
    top: 150px;
    translate: -50% 0;
}

.stun-content {
    background-color: rgba(200, 50, 50, 0.9);
    padding: 15px 40px;
    border-radius: 10px;
    align-items: center;
}

.stun-label {
    font-size: 32px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.stun-progress-container {
    width: 200px;
    height: 8px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 4px;
}

.stun-progress-bar {
    height: 100%;
    background-color: rgb(255, 200, 200);
    border-radius: 4px;
    width: 100%;
}

/* ==========================================
   Countdown Panel
   ========================================== */

.countdown-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.countdown-label {
    font-size: 200px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
}

/* ==========================================
   Score Popup
   ========================================== */

.score-popup-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

.score-popup {
    position: absolute;
    font-size: 32px;
    color: rgb(100, 255, 100);
    -unity-font-style: bold;
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.8);
    transition: opacity 0.5s ease-out, translate 0.5s ease-out;
}

.score-popup--high {
    color: rgb(255, 215, 0);
    font-size: 40px;
}

.score-popup--critical {
    color: rgb(255, 100, 100);
    font-size: 48px;
}

/* ==========================================
   Scoreboard
   ========================================== */

.scoreboard-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.scoreboard-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
}

.scoreboard-content {
    background-color: rgba(20, 20, 30, 0.95);
    padding: 30px 40px;
    border-radius: 15px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    min-width: 700px;
}

.scoreboard-title {
    font-size: 32px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.scoreboard-teams {
    flex-direction: row;
    justify-content: space-around;
    margin-bottom: 15px;
}

.scoreboard-team {
    padding: 8px 30px;
    border-radius: 5px;
}

.scoreboard-team--team0 {
    background-color: rgba(100, 150, 255, 0.3);
}

.scoreboard-team--team1 {
    background-color: rgba(255, 100, 100, 0.3);
}

.scoreboard-team-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
}

.scoreboard-header {
    flex-direction: row;
    padding: 10px 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.3);
    margin-bottom: 10px;
}

.scoreboard-header-cell {
    font-size: 16px;
    color: rgb(180, 180, 180);
    min-width: 100px;
    -unity-text-align: middle-center;
}

.scoreboard-header-role {
    min-width: 80px;
}

.scoreboard-header-name {
    min-width: 200px;
    -unity-text-align: middle-left;
}

.scoreboard-container {
    max-height: 400px;
}

.scoreboard-row {
    flex-direction: row;
    padding: 12px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.scoreboard-row--local {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 5px;
}

.scoreboard-row--team0 {
    border-left-width: 3px;
    border-left-color: rgb(100, 150, 255);
}

.scoreboard-row--team1 {
    border-left-width: 3px;
    border-left-color: rgb(255, 100, 100);
}

.scoreboard-role {
    font-size: 14px;
    min-width: 80px;
    -unity-text-align: middle-center;
    padding: 4px 8px;
    border-radius: 3px;
}

.scoreboard-role--hunter {
    background-color: rgba(100, 200, 100, 0.5);
    color: white;
}

.scoreboard-role--wolf {
    background-color: rgba(150, 100, 50, 0.5);
    color: white;
}

.scoreboard-name {
    font-size: 18px;
    color: white;
    min-width: 200px;
}

.scoreboard-score {
    font-size: 18px;
    color: rgb(255, 215, 0);
    min-width: 100px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.scoreboard-hits {
    font-size: 18px;
    color: white;
    min-width: 100px;
    -unity-text-align: middle-center;
}

.scoreboard-accuracy {
    font-size: 18px;
    color: rgb(150, 200, 255);
    min-width: 100px;
    -unity-text-align: middle-center;
}

/* ==========================================
   Pause Panel
   ========================================== */

.pause-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
}

.pause-content {
    background-color: rgba(30, 30, 40, 0.95);
    padding: 40px 60px;
    border-radius: 15px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    align-items: center;
}

.pause-title {
    font-size: 48px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 40px;
}

.pause-button {
    font-size: 24px;
    color: white;
    background-color: rgb(60, 60, 80);
    padding: 15px 50px;
    border-radius: 10px;
    margin-bottom: 15px;
    min-width: 250px;
    -unity-text-align: middle-center;
}

.pause-button:hover {
    background-color: rgb(80, 80, 100);
}

.pause-button--primary {
    background-color: rgb(60, 140, 60);
}

.pause-button--primary:hover {
    background-color: rgb(80, 160, 80);
}

.pause-button--danger {
    background-color: rgb(140, 60, 60);
}

.pause-button--danger:hover {
    background-color: rgb(160, 80, 80);
}

/* ==========================================
   Match End Panel
   ========================================== */

.match-end-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.match-end-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
}

.match-end-content {
    align-items: center;
}

.match-result-label {
    font-size: 96px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    text-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
}

.result-victory {
    color: rgb(100, 255, 100);
}

.result-defeat {
    color: rgb(255, 100, 100);
}

.result-draw {
    color: rgb(200, 200, 200);
}

.final-score-label {
    font-size: 36px;
    color: white;
    margin-bottom: 40px;
}

.continue-button {
    font-size: 28px;
    color: white;
    background-color: rgb(60, 120, 200);
    padding: 20px 60px;
    border-radius: 10px;
}

.continue-button:hover {
    background-color: rgb(80, 140, 220);
}

/* ==========================================
   Bottom Bar
   ========================================== */

.bottom-bar {
    flex-direction: row;
    justify-content: center;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.4);
}

.hint-text {
    font-size: 14px;
    color: rgb(150, 150, 150);
}
