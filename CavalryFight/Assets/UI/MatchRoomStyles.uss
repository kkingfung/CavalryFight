/* ===========================================
   Match Room Scene Stylesheet
   =========================================== */

/* Root Container */
#Root {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
}

/* ===========================================
   Header
   =========================================== */

#Header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 1% 2%;
}

/* Title Label */
#TitleLabel {
    font-size: 96px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Black');
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
}

/* Join Code Label */
#JoinCodeLabel {
    font-size: 48px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 215, 0);
    background-color: rgba(0, 0, 0, 0.6);
    padding: 10px 20px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 215, 0, 0.5);
}

/* ===========================================
   Content Area
   =========================================== */

#ContentArea {
    flex-grow: 1;
    flex-direction: row;
    margin: 0 2% 2% 2%;
}

/* Panels */
#LeftPanel, #RightPanel {
    border-radius: 10px;
    padding: 20px;
}

#LeftPanel {
    background-color: rgba(0, 0, 0, 0.5);
    width: 45%;
    margin-right: 2%;
    flex-direction: column;
}

#RightPanel {
    background-color: rgba(0, 0, 0, 0.7);
    width: 53%;
    flex-direction: column;
}

/* Panel Titles */
.panel-title {
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
    margin-bottom: 20px;
}

/* Section Headers */
.section-header {
    font-size: 48px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(220, 220, 220);
    margin-bottom: 15px;
}

/* ===========================================
   Player List (Left Panel)
   =========================================== */

.player-list-container {
    flex-grow: 1;
}

/* Player List Item - Light Grey Style */
.player-item {
    background-color: rgba(150, 150, 150, 0.3);
    border-radius: 3px;
    padding: 12px 15px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-width: 2px;
    border-color: rgba(120, 120, 120, 0.5);
    transition-duration: 0.2s;
}

.player-item:hover {
    background-color: rgba(170, 170, 170, 0.4);
    border-color: rgba(100, 100, 100, 0.8);
}

/* Empty Player Slot */
.player-item.empty {
    background-color: rgba(100, 100, 100, 0.2);
    border-color: rgba(80, 80, 80, 0.4);
}

.player-item.empty:hover {
    background-color: rgba(120, 120, 120, 0.3);
    border-color: rgba(100, 100, 100, 0.6);
}

/* Player Info Section - One Line Layout */
.player-item-info {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.player-item-name {
    font-size: 38px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(50, 50, 50);
    margin-right: 30px;
    width: 420px;
    flex-shrink: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.player-item-name.empty {
    color: rgba(100, 100, 100, 0.6);
    -unity-font-style: italic;
}

/* Local Player Row - Highlighted Background */
.player-item.local-player {
    background-color: rgba(255, 220, 100, 0.25);
    border-color: rgba(255, 200, 50, 0.6);
}

.player-item-stats {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.player-item-fps {
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(60, 60, 60);
    width: 140px;
    flex-shrink: 0;
}

/* Team Badge - StarCraft Style */
.team-badge {
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    padding: 6px 14px;
    border-radius: 3px;
    margin-right: 25px;
    border-width: 2px;
    width: 200px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.team-a {
    color: rgb(100, 220, 255);
    background-color: rgba(0, 80, 120, 0.8);
    border-color: rgba(0, 180, 220, 0.8);
}

.team-b {
    color: rgb(255, 180, 80);
    background-color: rgba(120, 60, 0, 0.8);
    border-color: rgba(220, 120, 0, 0.8);
}

.team-none {
    color: rgba(160, 180, 200, 0.8);
    background-color: rgba(40, 50, 60, 0.6);
    border-color: rgba(80, 100, 120, 0.6);
}

/* Ready Status Badge - StarCraft Style */
.ready-badge {
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    padding: 6px 14px;
    border-radius: 3px;
    margin-right: 25px;
    border-width: 2px;
    width: 200px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.ready-true {
    color: rgb(100, 255, 180);
    background-color: rgba(0, 100, 60, 0.8);
    border-color: rgba(0, 200, 120, 0.8);
}

.ready-false {
    color: rgba(200, 180, 140, 0.9);
    background-color: rgba(80, 70, 40, 0.6);
    border-color: rgba(140, 120, 60, 0.6);
}

/* Host Badge - StarCraft Style */
.host-badge {
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Black');
    color: rgb(255, 220, 100);
    background-color: rgba(100, 80, 0, 0.8);
    padding: 6px 14px;
    border-radius: 3px;
    margin-right: 25px;
    border-width: 2px;
    border-color: rgba(200, 160, 0, 0.8);
    width: 200px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

/* Alignment Spacer - ensures FPS/Difficulty starts at same position */
.stats-spacer {
    width: 200px;
    margin-right: 25px;
    flex-shrink: 0;
}

/* Player Actions */
.player-item-actions {
    flex-direction: row;
    align-items: center;
    margin-left: 10px;
}

.team-button {
    width: 180px;
    height: 55px;
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    background-color: rgba(180, 180, 180, 0.7);
    border-radius: 3px;
    border-width: 2px;
    border-color: rgba(120, 120, 120, 0.8);
    margin-right: 8px;
    color: rgb(40, 40, 40);
    transition-duration: 0.15s;
}

.team-button:hover {
    background-color: rgba(200, 200, 200, 0.9);
    border-color: rgba(80, 80, 80, 1);
    color: rgb(0, 0, 0);
}

.team-button:active {
    background-color: rgba(160, 160, 160, 0.9);
    scale: 0.98;
}

.kick-button {
    width: 180px;
    height: 55px;
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    background-color: rgba(200, 80, 80, 0.7);
    border-radius: 3px;
    border-width: 2px;
    border-color: rgba(150, 50, 50, 0.8);
    color: rgb(255, 255, 255);
    transition-duration: 0.15s;
}

.kick-button:hover {
    background-color: rgba(220, 100, 100, 0.9);
    border-color: rgba(180, 60, 60, 1);
    color: rgb(255, 255, 255);
}

.kick-button:active {
    background-color: rgba(180, 60, 60, 0.9);
    scale: 0.98;
}

/* Add NPC Button */
.add-npc-button {
    width: 180px;
    height: 55px;
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    background-color: rgba(100, 180, 100, 0.7);
    border-radius: 3px;
    border-width: 2px;
    border-color: rgba(80, 150, 80, 0.8);
    color: rgb(255, 255, 255);
    margin-right: 8px;
    transition-duration: 0.15s;
}

.add-npc-button:hover {
    background-color: rgba(120, 200, 120, 0.9);
    border-color: rgba(100, 180, 100, 1);
    color: rgb(255, 255, 255);
}

.add-npc-button:active {
    background-color: rgba(80, 160, 80, 0.9);
    scale: 0.98;
}

/* ===========================================
   Room Settings (Right Panel)
   =========================================== */

/* Room Information Section */
#RoomInfoSection {
    margin-bottom: 30px;
}

/* Game Settings Section */
#GameSettingsSection {
    margin-bottom: 30px;
    padding: 20px;
    background-color: rgba(100, 100, 100, 0.1);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(100, 100, 100, 0.3);
}

/* Detail Rows */
.detail-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 15px;
    align-items: center;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 5px;
}

.detail-label {
    font-size: 36px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(220, 220, 220);
    min-width: 200px;
    margin-right: 15px;
    flex-shrink: 0;
}

.detail-value {
    font-size: 36px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
    flex-grow: 1;
    -unity-text-align: middle-right;
    max-width: 1000px;
}

/* Setting Dropdown - Light Grey Style */
.setting-dropdown {
    flex-grow: 1;
    min-width: 250px;
    max-width: 1000px;
    height: 60px;
    font-size: 36px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    background-color: rgba(200, 200, 200, 0.9);
    border-radius: 3px;
    border-width: 2px;
    border-color: rgba(120, 120, 120, 0.8);
    color: rgb(0, 0, 0);
    padding-left: 10px;
    padding-right: 10px;
    margin-left: auto;
    transition-duration: 0.15s;
}

/* Dropdown text right-alignment */
.setting-dropdown .unity-base-popup-field__text {
    -unity-text-align: middle-right;
    padding-right: 35px;
    color: rgb(0, 0, 0);
}

/* Dropdown arrow */
.setting-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

/* Dropdown list (popup menu) */
.setting-dropdown .unity-base-popup-field__input {
    background-color: rgba(220, 220, 220, 0.98);
}

/* Dropdown menu items - right align */
.unity-base-dropdown__item {
    -unity-text-align: middle-right;
    color: rgb(0, 0, 0);
    padding-right: 15px;
    background-color: rgba(220, 220, 220, 0.95);
}

.unity-base-dropdown__item:hover {
    background-color: rgba(180, 180, 180, 0.95);
    color: rgb(0, 0, 0);
}

.unity-base-dropdown__label {
    -unity-text-align: middle-right;
    color: rgb(0, 0, 0);
}

.setting-dropdown:hover {
    background-color: rgba(220, 220, 220, 1);
    border-color: rgba(100, 100, 100, 1);
}

.setting-dropdown:focus {
    border-color: rgb(80, 80, 80);
    background-color: rgba(230, 230, 230, 1);
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

/* Setting TextField - Light Grey Style */
.setting-textfield {
    flex-grow: 1;
    min-width: 250px;
    max-width: 1000px;
    height: 60px;
    font-size: 36px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    background-color: rgba(200, 200, 200, 0.9);
    border-radius: 3px;
    border-width: 2px;
    border-color: rgba(120, 120, 120, 0.8);
    color: rgb(0, 0, 0);
    padding-left: 10px;
    padding-right: 10px;
    margin-left: auto;
    transition-duration: 0.15s;
}

.setting-textfield:hover {
    background-color: rgba(220, 220, 220, 1);
    border-color: rgba(100, 100, 100, 1);
}

.setting-textfield:focus {
    border-color: rgb(80, 80, 80);
    background-color: rgba(230, 230, 230, 1);
}

/* Password TextField - text is transparent, asterisks label shows instead */
#PasswordField .unity-text-field__input {
    color: transparent;
    --unity-cursor-color: rgb(0, 0, 0);
}

/* Password Asterisks Label - shows black asterisks on top of transparent text */
#PasswordAsterisksLabel {
    font-size: 36px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(0, 0, 0);
    -unity-text-align: middle-left;
}

/* Setting Toggle - StarCraft Style */
.setting-toggle {
    flex-grow: 1;
    max-width: 1000px;
    font-size: 36px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    margin-left: auto;
    flex-direction: row-reverse;
    justify-content: flex-start;
}

.setting-toggle .unity-toggle__input {
    width: 45px;
    height: 45px;
    margin-right: 15px;
    flex-shrink: 0;
    justify-content: flex-end;
}

.setting-toggle .unity-toggle__checkmark {
    width: 35px;
    height: 35px;
    border-radius: 3px;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    background-color: rgba(128, 128, 128, 0.3);
}

.setting-toggle:checked .unity-toggle__checkmark {
    background-color: rgba(255, 255, 255, 1);
    border-color: rgba(128, 128, 128, 0.3);
}

/* Status Label */
#StatusLabel {
    font-size: 42px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(220, 220, 220);
    -unity-text-align: middle-center;
    margin-top: 20px;
}

/* ===========================================
   Buttons
   =========================================== */

.header-button {
    width: 200px;
    height: 80px;
    font-size: 48px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    background-color: rgba(100, 100, 100, 0.5);
    border-radius: 8px;
    border-width: 0;
    transition-duration: 0.15s;
}

.header-button:hover {
    background-color: rgba(150, 150, 150, 0.7);
}

.header-button:active {
    background-color: rgba(80, 80, 80, 0.6);
    scale: 0.98;
}

.action-button {
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    -unity-text-align: middle-center;
    border-radius: 10px;
    border-width: 0;
    margin-bottom: 15px;
}

.primary-button {
    background-color: rgba(100, 100, 100, 0.7);
    height: 100px;
    transition-duration: 0.15s;
}

.primary-button:hover {
    background-color: rgba(150, 150, 150, 0.9);
}

.primary-button:active {
    background-color: rgba(80, 80, 80, 0.8);
    scale: 0.98;
}

.danger-button {
    background-color: rgba(255, 50, 50, 0.7);
    height: 80px;
    transition-duration: 0.15s;
}

.danger-button:hover {
    background-color: rgba(255, 70, 70, 0.9);
}

.danger-button:active {
    background-color: rgba(220, 40, 40, 0.9);
    scale: 0.98;
}

.footer-button {
    width: 400px;
    height: 100px;
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    background-color: rgba(100, 100, 100, 0.7);
    border-radius: 10px;
    border-width: 0;
    transition-duration: 0.15s;
}

.footer-button:hover {
    background-color: rgba(120, 120, 120, 0.9);
}

.footer-button:active {
    background-color: rgba(80, 80, 80, 0.8);
    scale: 0.98;
}

.footer-button.primary-button {
    background-color: rgba(50, 150, 255, 0.7);
}

.footer-button.primary-button:hover {
    background-color: rgba(70, 170, 255, 0.9);
}

.footer-button.primary-button:active {
    background-color: rgba(40, 130, 220, 0.9);
    scale: 0.98;
}

/* ===========================================
   Countdown Dialog
   =========================================== */

#CountdownDialog {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
}

#CountdownLabel {
    font-size: 120px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Black');
    color: rgb(255, 200, 100);
    -unity-text-align: middle-center;
}

/* ===========================================
   NPC Difficulty Dropdown (in player cells)
   =========================================== */

.npc-difficulty-dropdown {
    width: 200px;
    height: 50px;
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    background-color: rgba(200, 200, 200, 0.9);
    border-radius: 3px;
    border-width: 2px;
    border-color: rgba(120, 120, 120, 0.8);
    color: rgb(0, 0, 0);
    padding-left: 10px;
    padding-right: 10px;
    flex-shrink: 0;
    transition-duration: 0.15s;
}

.npc-difficulty-dropdown .unity-base-popup-field__text {
    -unity-text-align: middle-center;
    color: rgb(0, 0, 0);
}

.npc-difficulty-dropdown:hover {
    background-color: rgba(220, 220, 220, 1);
    border-color: rgba(100, 100, 100, 1);
}

.npc-difficulty-dropdown:focus {
    border-color: rgb(80, 80, 80);
    background-color: rgba(230, 230, 230, 1);
}
