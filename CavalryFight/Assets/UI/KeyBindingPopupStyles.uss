/* =====================================
   Key Binding Popup Styles
   Matching the dark theme of Settings popup
   ===================================== */

/* Root Container */
.keybinding-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    position: absolute;
    width: 100%;
    height: 100%;
}

/* Overlay with higher z-index to appear above settings */
.keybinding-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
}

/* Popup Container */
.keybinding-popup-container {
    background-color: rgba(30, 30, 30, 0.98);
    border-radius: 15px;
    padding: 30px;
    width: 85%;
    height: 80%;
    max-width: 1600px;
    min-width: 1000px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    flex-direction: column;
}

/* Header */
.keybinding-header {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
}

.keybinding-title {
    color: rgb(255, 255, 255);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    -unity-text-align: middle-center;
}

/* Scrollable Content */
.keybinding-scroll {
    flex-grow: 1;
    margin-bottom: 15px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 10px;
    padding: 10px;
}

.bindings-container {
    flex-grow: 1;
}

/* Binding Row */
.binding-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    margin-bottom: 8px;
    background-color: rgba(60, 60, 60, 0.6);
    border-radius: 8px;
    transition-duration: 0.15s;
}

.binding-row:hover {
    background-color: rgba(80, 80, 80, 0.7);
}

.binding-action-name {
    font-size: 28px;
    color: rgb(255, 255, 255);
    min-width: 300px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
}

.binding-current-key {
    font-size: 28px;
    color: rgb(100, 200, 255);
    min-width: 200px;
    -unity-text-align: middle-center;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
}

.binding-rebind-button {
    width: 180px;
    height: 50px;
    font-size: 22px;
    background-color: rgb(70, 70, 70);
    color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    transition-duration: 0.15s;
}

.binding-rebind-button:hover {
    background-color: rgb(90, 90, 90);
    border-color: rgb(150, 150, 150);
}

.binding-rebind-button:active {
    background-color: rgb(50, 50, 50);
    scale: 0.98;
}

/* Rebinding Prompt */
.rebinding-prompt {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    background-color: rgb(200, 100, 50);
    border-radius: 10px;
    padding: 15px 30px;
    margin-top: 10px;
    margin-bottom: 10px;
    border-width: 3px;
    border-color: rgb(255, 150, 50);
    min-height: 60px;
    opacity: 0;
}

/* Footer */
.keybinding-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 15px;
    border-top-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.2);
}

.keybinding-button {
    width: 220px;
    height: 50px;
    font-size: 24px;
    background-color: rgb(70, 70, 70);
    color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    transition-duration: 0.15s;
}

.keybinding-button:hover {
    background-color: rgb(90, 90, 90);
    border-color: rgb(150, 150, 150);
}

.keybinding-button:active {
    background-color: rgb(50, 50, 50);
    scale: 0.98;
}

/* Primary Button (Close) */
.primary-button {
    background-color: rgb(60, 120, 80);
    border-color: rgb(80, 160, 100);
    transition-duration: 0.15s;
}

.primary-button:hover {
    background-color: rgb(70, 140, 90);
    border-color: rgb(100, 180, 120);
}

.primary-button:active {
    background-color: rgb(50, 100, 70);
    scale: 0.98;
}
