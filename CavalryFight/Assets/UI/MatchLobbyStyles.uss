/* ===========================================
   Match Lobby Scene Stylesheet
   =========================================== */

/* Root Container */
#Root {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
}

/* Header - fixed size */
#Header {
    flex-grow: 0;
    flex-shrink: 0;
}

/* Button Section - fixed size */
#ButtonSection {
    flex-grow: 0;
    flex-shrink: 0;
}

/* ===========================================
   Filter Section
   =========================================== */

#FilterSection {
    flex-direction: row;
    align-items: center;
    margin-bottom: 15px;
    padding: 12px 18px;
    background-color: rgba(40, 50, 70, 0.85);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(100, 130, 180, 0.4);
    flex-shrink: 0;
}

#FilterSection .filter-label {
    font-size: 34px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
    margin-right: 20px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

#FilterSection .filter-dropdown {
    width: 600px;
    height: 50px;
    font-size: 30px;
    margin-right: 25px;
    background-color: rgba(60, 80, 120, 0.8);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(120, 150, 200, 0.5);
    color: rgb(255, 255, 255);
}

#FilterSection .filter-dropdown > .unity-base-field__label {
    color: rgb(255, 255, 255);
}

#FilterSection .filter-dropdown > .unity-popup-field__input {
    background-color: rgba(60, 80, 120, 0.8);
    color: rgb(255, 255, 255);
}

#FilterSection .filter-toggle {
    margin-right: 30px;
}

#FilterSection .filter-toggle > .unity-toggle__input {
    background-color: rgba(60, 80, 120, 0.8);
    border-color: rgba(120, 150, 200, 0.5);
}

#FilterSection .filter-toggle > Label {
    font-size: 30px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.4);
}

/* ===========================================
   Header
   =========================================== */

#Header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 1% 2%;
}

/* Title Label */
#TitleLabel {
    font-size: 96px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Black');
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
}

/* Header Button */
.header-button {
    width: 200px;
    height: 80px;
    font-size: 48px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    background-color: rgba(100, 100, 100, 0.5);
    border-radius: 8px;
    border-width: 0;
    transition-duration: 0.15s;
}

.header-button:hover {
    background-color: rgba(150, 150, 150, 0.7);
}

.header-button:active {
    background-color: rgba(80, 80, 80, 0.6);
    scale: 0.98;
}

/* ===========================================
   Content Area
   =========================================== */

#ContentArea {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    margin: 0 2% 2% 2%;
    min-height: 0;
    overflow: hidden;
}

/* Panels */
#LeftPanel, #RightPanel {
    border-radius: 10px;
    padding: 20px;
}

#LeftPanel {
    background-color: rgba(0, 0, 0, 0.5);
    width: 45%;
    margin-right: 2%;
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
    height: 100%;
    overflow: hidden;
}

#RightPanel {
    background-color: rgba(0, 0, 0, 0.7);
    width: 53%;
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
    height: 100%;
    overflow: hidden;
}

/* Panel Titles */
.panel-title {
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
    margin-bottom: 20px;
    flex-shrink: 0;
}

/* Section Headers */
.section-header {
    font-size: 48px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(220, 220, 220);
    margin-bottom: 15px;
}

/* ===========================================
   Room List (Left Panel)
   =========================================== */

#RoomListScrollView {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.room-list-container {
    flex-grow: 0;
    flex-shrink: 0;
}

/* Room List Item - Redesigned for better readability */
.room-item {
    background-color: rgba(30, 40, 60, 0.85);
    border-radius: 10px;
    padding: 18px 20px;
    margin-bottom: 12px;
    flex-direction: column;
    border-width: 2px;
    border-color: rgba(100, 120, 160, 0.4);
    transition-duration: 0.2s;
}

.room-item:hover {
    background-color: rgba(40, 55, 85, 0.95);
    border-color: rgba(120, 150, 200, 0.6);
}

.room-item.selected {
    background-color: rgba(60, 100, 180, 0.6);
    border-color: rgb(100, 150, 255);
    border-width: 3px;
}

/* Room Item Header - Room Name and Status Badges */
.room-item-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.room-item-name {
    font-size: 40px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
    flex-grow: 1;
    flex-shrink: 1;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* Status Badges Container */
.room-item-badges {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.room-item-badge {
    font-size: 24px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    padding: 6px 14px;
    border-radius: 15px;
    margin-left: 10px;
    -unity-text-align: middle-center;
}

.badge-open {
    color: rgb(50, 200, 50);
    background-color: rgba(50, 200, 50, 0.25);
    border-width: 1px;
    border-color: rgba(50, 200, 50, 0.5);
}

.badge-full {
    color: rgb(255, 100, 100);
    background-color: rgba(255, 100, 100, 0.25);
    border-width: 1px;
    border-color: rgba(255, 100, 100, 0.5);
}

.badge-password {
    color: rgb(255, 180, 80);
    background-color: rgba(255, 180, 80, 0.25);
    border-width: 1px;
    border-color: rgba(255, 180, 80, 0.5);
}

/* Room Item Info Row */
.room-item-info {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.room-item-info-label {
    font-size: 28px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgba(180, 190, 210, 0.9);
    margin-right: 8px;
}

.room-item-info-value {
    font-size: 28px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
    margin-right: 25px;
}

/* Room Item Footer - Host and Players */
.room-item-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.15);
}

.room-item-host {
    font-size: 28px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgba(200, 210, 230, 0.9);
}

.room-item-players {
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
    background-color: rgba(100, 150, 255, 0.3);
    padding: 6px 16px;
    border-radius: 20px;
}

.room-item-players-full {
    background-color: rgba(255, 100, 100, 0.3);
    color: rgb(255, 180, 180);
}

/* Empty State */
#EmptyState, #NoSelectionState {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    align-items: center;
    justify-content: center;
}

/* Details Content */
#DetailsContent {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

#RoomInfoSection {
    flex-grow: 0;
    flex-shrink: 1;
    overflow: scroll;
}

#ActionsSection {
    flex-grow: 0;
    flex-shrink: 0;
}

#EmptyLabel, #NoSelectionLabel {
    font-size: 48px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgba(255, 255, 255, 0.5);
    -unity-text-align: middle-center;
}

/* ===========================================
   Room Details (Right Panel)
   =========================================== */

/* Detail Rows - Improved spacing and readability */
.detail-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    padding: 10px 15px;
    background-color: rgba(40, 55, 80, 0.5);
    border-radius: 6px;
}

.detail-label {
    font-size: 34px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
    min-width: 200px;
    margin-right: 30px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.4);
}

.detail-value {
    font-size: 36px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(150, 220, 255);
    flex-grow: 1;
}

/* Detail Section Divider */
.detail-section-divider {
    height: 2px;
    background-color: rgba(100, 150, 200, 0.3);
    margin: 25px 0;
}

/* Form Rows - Improved spacing */
.form-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 22px;
    padding: 10px 15px;
    background-color: rgba(40, 55, 80, 0.5);
    border-radius: 6px;
}

.form-label {
    font-size: 34px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
    min-width: 200px;
    margin-right: 30px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.4);
}

/* Status Message */
#StatusLabel {
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 200, 100);
    -unity-text-align: middle-center;
    padding: 12px 20px;
    background-color: rgba(100, 80, 30, 0.4);
    border-radius: 8px;
    margin-bottom: 15px;
}

/* Player Name Section (above Join by Code - similar layout) */
#PlayerNameSection {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    padding: 15px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 5px;
    flex-grow: 0;
    flex-shrink: 0;
}

/* Join by Code Section */
#JoinByCodeSection {
    flex-grow: 0;
    flex-shrink: 0;
}

#PlayerNameSection .player-name-label {
    font-size: 42px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
    min-width: 240px;
    margin-right: 20px;
}

#PlayerNameSection .player-name-input {
    flex-grow: 1;
    height: 70px;
    font-size: 40px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    background-color: rgba(255, 255, 255, 0.9);
    color: rgb(0, 0, 0);
    border-radius: 5px;
    border-width: 2px;
    border-color: rgba(120, 120, 120, 0.8);
    margin-right: 15px;
}

#PlayerNameSection .player-name-input > .unity-base-text-field__input {
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    padding: 0 15px;
    margin: 0;
    background-color: transparent;
    height: 100%;
}

#PlayerNameSection .player-name-input .unity-text-element {
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    height: 100%;
}

/* Join Code Input styling */
#JoinCodeInput {
    height: 70px;
    font-size: 40px;
}

#JoinCodeInput > .unity-base-text-field__input {
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    padding: 0 15px;
    margin: 0;
    background-color: transparent;
    height: 100%;
}

#JoinCodeInput .unity-text-element {
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    height: 100%;
}

/* Join Password Input styling */
#JoinPasswordInput {
    height: 70px;
    font-size: 40px;
}

#JoinPasswordInput > .unity-base-text-field__input {
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    padding: 0 15px;
    margin: 0;
    background-color: transparent;
    height: 100%;
    font-size: 40px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
}

#JoinPasswordInput .unity-text-element {
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    height: 100%;
    font-size: 40px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
}

#PlayerNameSection .player-name-button {
    width: 200px;
    height: 70px;
    font-size: 42px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    background-color: rgba(100, 140, 200, 0.8);
    color: rgb(0, 0, 0);
    border-radius: 5px;
    border-width: 2px;
    border-color: rgba(80, 120, 180, 0.8);
}

#PlayerNameSection .player-name-button:hover {
    background-color: rgba(120, 160, 220, 0.9);
}

#PlayerNameSection .player-name-button:active {
    background-color: rgba(80, 120, 180, 0.9);
    scale: 0.98;
}

#PlayerNameSection .player-name-button:disabled {
    background-color: rgba(80, 80, 80, 0.5);
    color: rgb(100, 100, 100);
}

.form-input {
    flex-grow: 1;
    height: 70px;
    font-size: 36px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    background-color: rgba(60, 70, 90, 0.7);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(100, 120, 160, 0.5);
    color: rgb(255, 255, 255);
    transition-duration: 0.15s;
}

.form-input:hover {
    border-color: rgba(120, 150, 200, 0.7);
}

.form-input:focus {
    border-color: rgb(100, 150, 255);
    background-color: rgba(70, 85, 110, 0.8);
}

/* TextField specific styling - inner input element */
.form-input > .unity-base-text-field__input {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    padding: 0 15px;
    margin: 0;
    background-color: transparent;
    height: 100%;
}

.form-input .unity-text-element {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
    height: 100%;
}

/* Password TextField - black text for asterisks */
#PasswordInput {
    background-color: rgba(255, 255, 255, 0.9);
    color: rgb(0, 0, 0);
    height: 70px;
    font-size: 36px;
}

#PasswordInput > .unity-base-text-field__input {
    color: rgb(0, 0, 0);
    background-color: transparent;
    -unity-text-align: middle-left;
    padding: 0 15px;
    margin: 0;
    height: 100%;
}

#PasswordInput .unity-text-element {
    color: rgb(0, 0, 0);
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
    height: 100%;
}

/* ===========================================
   Buttons
   =========================================== */

.action-button {
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    -unity-text-align: middle-center;
    border-radius: 10px;
    border-width: 0;
    margin-bottom: 15px;
}

.primary-button {
    background-color: rgba(50, 150, 255, 0.7);
    height: 100px;
    transition-duration: 0.15s;
}

.primary-button:hover {
    background-color: rgba(70, 170, 255, 0.9);
}

.primary-button:active {
    background-color: rgba(40, 130, 220, 0.9);
    scale: 0.98;
}

.footer-button {
    width: 400px;
    height: 100px;
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    background-color: rgba(100, 100, 100, 0.7);
    border-radius: 10px;
    border-width: 0;
    transition-duration: 0.15s;
}

.footer-button:hover {
    background-color: rgba(120, 120, 120, 0.9);
}

.footer-button:active {
    background-color: rgba(80, 80, 80, 0.8);
    scale: 0.98;
}

.footer-button.primary-button {
    background-color: rgba(50, 150, 255, 0.7);
}

.footer-button.primary-button:hover {
    background-color: rgba(70, 170, 255, 0.9);
}

.footer-button.primary-button:active {
    background-color: rgba(40, 130, 220, 0.9);
    scale: 0.98;
}

.footer-button.cancel-button {
    background-color: rgba(200, 80, 80, 0.8);
    color: rgb(0, 0, 0);
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    -unity-text-outline-width: 0;
}

.footer-button.cancel-button:hover {
    background-color: rgba(220, 100, 100, 0.9);
}

.footer-button.cancel-button:active {
    background-color: rgba(180, 60, 60, 0.9);
    scale: 0.98;
}
