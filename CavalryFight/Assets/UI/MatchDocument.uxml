<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements"
         editor="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <Style src="MatchStyles.uss" />

    <ui:VisualElement name="Root" class="root">

        <!-- HUD Panel (Top) -->
        <ui:VisualElement name="HUDPanel" class="hud-panel">

            <!-- Left: Player Stats -->
            <ui:VisualElement name="PlayerStatsPanel" class="player-stats-panel">
                <ui:VisualElement class="stat-row">
                    <ui:Label text="Score" class="stat-label" />
                    <ui:Label name="ScoreLabel" text="0" class="stat-value stat-value--score" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="Arrows" class="stat-label" />
                    <ui:Label name="ArrowsLabel" text="∞" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="Hits" class="stat-label" />
                    <ui:Label name="HitsLabel" text="0" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="Accuracy" class="stat-label" />
                    <ui:Label name="AccuracyLabel" text="0.0%" class="stat-value" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Center: Timer and Mode -->
            <ui:VisualElement name="CenterPanel" class="center-panel">
                <ui:Label name="GameModeBadge" text="Arena" class="game-mode-badge" />
                <ui:Label name="TimerLabel" text="5:00" class="timer-label" />
            </ui:VisualElement>

            <!-- Right: Team Scores (TeamFight mode only) -->
            <ui:VisualElement name="TeamScorePanel" class="team-score-panel" style="display: none;">
                <ui:VisualElement class="team-score team-score--team0">
                    <ui:Label text="Team A" class="team-name" />
                    <ui:Label name="Team0ScoreLabel" text="0" class="team-score-value" />
                </ui:VisualElement>
                <ui:Label text="vs" class="team-vs" />
                <ui:VisualElement class="team-score team-score--team1">
                    <ui:Label text="Team B" class="team-name" />
                    <ui:Label name="Team1ScoreLabel" text="0" class="team-score-value" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Countdown Panel (Center) -->
        <ui:VisualElement name="CountdownPanel" class="countdown-panel" style="display: none;">
            <ui:Label name="CountdownLabel" text="3" class="countdown-label" />
        </ui:VisualElement>

        <!-- Crosshair (Center of screen, shown when aiming) -->
        <ui:VisualElement name="CrosshairContainer" class="crosshair-container">
            <ui:VisualElement name="Crosshair" class="crosshair hidden">
                <ui:VisualElement class="crosshair-line crosshair-horizontal" />
                <ui:VisualElement class="crosshair-line crosshair-vertical" />
                <ui:VisualElement class="crosshair-dot" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Score Popup Container -->
        <ui:VisualElement name="ScorePopupContainer" class="score-popup-container" />

        <!-- Kill Feed Container (Top Right) -->
        <ui:VisualElement name="KillFeedContainer" class="kill-feed-container" />

        <!-- Scoreboard Panel (Tab to show) -->
        <ui:VisualElement name="ScoreboardPanel" class="scoreboard-panel" style="display: none;">
            <ui:VisualElement class="scoreboard-overlay" />
            <ui:VisualElement class="scoreboard-content">
                <ui:Label text="SCOREBOARD" class="scoreboard-title" />
                <ui:VisualElement class="scoreboard-header">
                    <ui:Label text="Player" class="scoreboard-header-cell scoreboard-header-name" />
                    <ui:Label text="Score" class="scoreboard-header-cell" />
                    <ui:Label text="Hits" class="scoreboard-header-cell" />
                    <ui:Label text="Accuracy" class="scoreboard-header-cell" />
                </ui:VisualElement>
                <ui:VisualElement name="ScoreboardContainer" class="scoreboard-container" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Settings Popup (shown when paused) -->
        <ui:VisualElement name="SettingsPopup" class="full-settings-popup hidden">
            <!-- Dark Overlay -->
            <ui:VisualElement class="overlay" />

            <!-- Settings Panel -->
            <ui:VisualElement class="full-settings-panel">
                <!-- Header -->
                <ui:VisualElement class="settings-header">
                    <ui:Label text="Settings" class="settings-title" />
                    <ui:Button name="KeyBindingsButton" text="Key Configuration" class="header-button" />
                </ui:VisualElement>

                <!-- Scrollable Content -->
                <ui:ScrollView class="settings-scroll">

                    <!-- Audio Section -->
                    <ui:VisualElement class="settings-section">
                        <ui:Label text="Audio Settings" class="section-header" />
                        <ui:Slider label="Master Volume" value="1" high-value="1" name="MasterVolumeSlider" class="setting-control" />
                        <ui:Slider label="BGM Volume" value="0.8" high-value="1" name="BgmVolumeSlider" class="setting-control" />
                        <ui:Slider label="SFX Volume" value="0.8" high-value="1" name="SfxVolumeSlider" class="setting-control" />
                    </ui:VisualElement>

                    <!-- Video Section -->
                    <ui:VisualElement class="settings-section">
                        <ui:Label text="Video Settings" class="section-header" />
                        <ui:DropdownField label="Display Mode" name="DisplayModeDropdown" class="setting-control" />
                        <ui:DropdownField label="Resolution" name="ResolutionDropdown" class="setting-control" />
                        <ui:DropdownField label="Quality Preset" name="QualityDropdown" class="setting-control" />
                        <ui:DropdownField label="Anti-Aliasing" name="AntiAliasingDropdown" class="setting-control" />
                        <ui:DropdownField label="Target FPS" name="TargetFpsDropdown" class="setting-control" />
                        <ui:Toggle label="VSync" name="VSyncToggle" value="true" class="setting-control" />
                    </ui:VisualElement>

                    <!-- Gameplay Section -->
                    <ui:VisualElement class="settings-section">
                        <ui:Label text="Gameplay Settings" class="section-header" />
                        <ui:Slider label="Camera Sensitivity" value="0.5" high-value="1" name="CameraSensitivitySlider" class="setting-control" />
                        <ui:Toggle label="Invert Y-Axis" name="InvertYAxisToggle" value="false" class="setting-control" />
                    </ui:VisualElement>

                </ui:ScrollView>

                <!-- Footer Buttons -->
                <ui:VisualElement class="settings-footer">
                    <!-- Left side: Resume and Leave Match -->
                    <ui:VisualElement class="footer-left">
                        <ui:Button name="ResumeButton" text="Resume" class="footer-button primary-button" />
                        <ui:Button name="LeaveMatchButton" text="Leave Match" class="footer-button danger-button" />
                    </ui:VisualElement>
                    <!-- Right side: Apply and Reset -->
                    <ui:VisualElement class="footer-right">
                        <ui:Button name="ApplySettingsButton" text="Apply" class="footer-button" />
                        <ui:Button name="ResetSettingsButton" text="Reset" class="footer-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Match End Panel -->
        <ui:VisualElement name="MatchEndPanel" class="match-end-panel" style="display: none;">
            <ui:VisualElement class="match-end-overlay" />
            <ui:VisualElement class="match-end-content">
                <ui:Label name="MatchResultLabel" text="VICTORY" class="match-result-label result-victory" />
                <ui:Label name="FinalScoreLabel" text="Score: 0" class="final-score-label" />
                <ui:Button name="ContinueButton" text="Continue" class="continue-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom Info Bar -->
        <ui:VisualElement name="BottomBar" class="bottom-bar">
            <ui:Label text="[Tab] Scoreboard  |  [Esc] Pause" class="hint-text" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
