/* =====================================
   Training Scene Styles
   ===================================== */

/* Root */
.root {
    width: 100%;
    height: 100%;
    position: absolute;
}

/* =====================================
   HUD Styles
   ===================================== */

.hud {
    width: 100%;
    height: 100%;
    position: absolute;
    flex-direction: row;
    justify-content: space-between;
    padding: 20px;
}

/* Statistics Panel (Top Left) */
.statistics-panel {
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 10px;
    padding: 15px;
    align-self: flex-start;
    min-width: 200px;
}

.stat-label {
    color: rgb(255, 255, 255);
    font-size: 18px;
    margin-bottom: 5px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=6baf05084dbc11f4da7f2e3fb5dd3e29&type=3#NotInter-Regular");
}

/* Controls Panel (Top Right) */
.controls-panel {
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 10px;
    padding: 15px;
    align-self: flex-start;
    min-width: 200px;
}

.controls-title {
    color: rgb(255, 255, 255);
    font-size: 20px;
    margin-bottom: 10px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=6baf05084dbc11f4da7f2e3fb5dd3e29&type=3#NotInter-Regular");
}

.control-label {
    color: rgb(200, 200, 200);
    font-size: 14px;
    margin-bottom: 3px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=6baf05084dbc11f4da7f2e3fb5dd3e29&type=3#NotInter-Regular");
}

/* =====================================
   Pause Menu Styles
   ===================================== */

.pause-menu {
    width: 100%;
    height: 100%;
    position: absolute;
    align-items: center;
    justify-content: center;
}

/* Dark Overlay */
.overlay {
    width: 100%;
    height: 100%;
    position: absolute;
    background-color: rgba(0, 0, 0, 0.7);
}

/* Menu Panel */
.menu-panel {
    background-color: rgb(40, 40, 40);
    border-radius: 15px;
    padding: 40px;
    min-width: 400px;
    align-items: center;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
}

.menu-title {
    color: rgb(255, 255, 255);
    font-size: 36px;
    margin-bottom: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=6baf05084dbc11f4da7f2e3fb5dd3e29&type=3#NotInter-Regular");
}

.menu-button {
    width: 300px;
    height: 50px;
    margin-bottom: 15px;
    font-size: 20px;
    background-color: rgb(70, 70, 70);
    color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=6baf05084dbc11f4da7f2e3fb5dd3e29&type=3#NotInter-Regular");
}

.menu-button:hover {
    background-color: rgb(90, 90, 90);
    border-color: rgb(150, 150, 150);
}

.menu-button:active {
    background-color: rgb(50, 50, 50);
}

/* =====================================
   Utility Classes
   ===================================== */

.hidden {
    display: none;
}
