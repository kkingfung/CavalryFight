/* ===========================================
   Results Scene Stylesheet
   =========================================== */

/* Root Container */
#Root {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
}

/* ===========================================
   Header
   =========================================== */

#Header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 1% 2%;
}

/* Title Label */
#TitleLabel {
    font-size: 96px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Black');
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
}

/* Result Badge */
.result-badge {
    padding: 15px 40px;
    border-radius: 10px;
    border-width: 3px;
}

.result-badge-text {
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Black');
    -unity-text-align: middle-center;
}

/* Result States */
.result-victory .result-badge-text {
    color: rgb(100, 255, 100);
}

.result-victory {
    background-color: rgba(0, 255, 0, 0.2);
    border-color: rgb(100, 255, 100);
}

.result-defeat .result-badge-text {
    color: rgb(255, 100, 100);
}

.result-defeat {
    background-color: rgba(255, 0, 0, 0.2);
    border-color: rgb(255, 100, 100);
}

.result-draw .result-badge-text {
    color: rgb(200, 200, 200);
}

.result-draw {
    background-color: rgba(128, 128, 128, 0.2);
    border-color: rgb(200, 200, 200);
}

/* ===========================================
   Content Area
   =========================================== */

#ContentArea {
    flex-grow: 1;
    flex-direction: row;
    margin: 0 2% 2% 2%;
}

/* Panels */
#LeftPanel, #RightPanel {
    border-radius: 10px;
    padding: 20px;
}

#LeftPanel {
    background-color: rgba(0, 0, 0, 0.5);
    width: 45%;
    margin-right: 2%;
    flex-direction: column;
}

#RightPanel {
    background-color: rgba(0, 0, 0, 0.7);
    width: 53%;
    flex-direction: column;
}

/* Panel Titles */
.panel-title {
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
    margin-bottom: 20px;
}

/* Section Headers */
.section-header {
    font-size: 48px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(220, 220, 220);
    margin-bottom: 15px;
}

/* ===========================================
   Score Section
   =========================================== */

.score-box {
    align-items: center;
    padding: 20px 40px;
    border-radius: 10px;
    min-width: 150px;
}

.player-score {
    background-color: rgba(100, 150, 255, 0.3);
    border-width: 2px;
    border-color: rgb(100, 150, 255);
}

.enemy-score {
    background-color: rgba(255, 100, 100, 0.3);
    border-width: 2px;
    border-color: rgb(255, 100, 100);
}

.score-team-label {
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(200, 200, 200);
    margin-bottom: 10px;
}

.score-value {
    font-size: 96px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Black');
    color: rgb(255, 255, 255);
}

.score-separator {
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(180, 180, 180);
    margin: 0 30px;
    -unity-text-align: middle-center;
}

/* ===========================================
   Detail Rows
   =========================================== */

.detail-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.detail-label {
    font-size: 36px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(180, 180, 180);
    width: 200px;
}

.detail-value {
    font-size: 36px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(255, 255, 255);
    flex-grow: 1;
}

/* ===========================================
   Stats Grid
   =========================================== */

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.stat-item {
    width: 30%;
    align-items: center;
    margin-bottom: 25px;
    padding: 15px 10px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
}

.stat-label {
    font-size: 28px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(180, 180, 180);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.stat-value {
    font-size: 48px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
}

/* ===========================================
   Replay Section
   =========================================== */

#ReplaySection {
    margin-top: 30px;
}

.replay-saved-badge {
    background-color: rgba(100, 200, 100, 0.3);
    padding: 10px 20px;
    border-radius: 8px;
    margin-right: 15px;
    border-width: 2px;
    border-color: rgb(100, 200, 100);
}

.badge-text {
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(100, 255, 100);
}

/* ===========================================
   Leaderboard Section
   =========================================== */

#LeaderboardSection {
    flex-grow: 1;
    flex-direction: column;
}

.leaderboard-header {
    flex-direction: row;
    padding: 10px 15px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 8px 8px 0 0;
    margin-bottom: 2px;
}

.leaderboard-container {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 0 0 8px 8px;
}

.leaderboard-col {
    font-size: 28px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
}

.leaderboard-col-rank {
    width: 50px;
}

.leaderboard-col-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    padding-left: 10px;
}

.leaderboard-col-score {
    width: 80px;
}

.leaderboard-col-stat {
    width: 70px;
}

.leaderboard-col-status {
    width: 100px;
}

/* Player Row */
.player-row {
    flex-direction: row;
    padding: 12px 15px;
    background-color: rgba(255, 255, 255, 0.05);
    margin-bottom: 2px;
    border-left-width: 4px;
    border-left-color: transparent;
    transition-duration: 0.15s;
}

.player-row:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.player-row-local {
    background-color: rgba(100, 150, 255, 0.2);
    border-left-color: rgb(100, 150, 255);
}

.player-row-local:hover {
    background-color: rgba(100, 150, 255, 0.3);
}

.player-row-first {
    background-color: rgba(255, 215, 0, 0.15);
    border-left-color: rgb(255, 215, 0);
}

.player-row-first:hover {
    background-color: rgba(255, 215, 0, 0.25);
}

.player-row-dead {
    opacity: 0.6;
}

.player-row-value {
    font-size: 28px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.player-row-rank {
    width: 50px;
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
}

.player-row-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    padding-left: 10px;
}

.player-row-score {
    width: 80px;
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 220, 100);
}

.player-row-stat {
    width: 70px;
}

.player-row-status {
    width: 100px;
}

/* Status badges */
.status-alive {
    color: rgb(100, 255, 100);
}

.status-dead {
    color: rgb(255, 100, 100);
}

/* Rank colors */
.rank-1 {
    color: rgb(255, 215, 0);
}

.rank-2 {
    color: rgb(192, 192, 192);
}

.rank-3 {
    color: rgb(205, 127, 50);
}

/* ===========================================
   Rematch Section
   =========================================== */

#RematchSection {
    margin-top: 30px;
    padding: 20px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
}

.rematch-status-label {
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(255, 200, 100);
    margin-bottom: 5px;
}

.rematch-count-label {
    font-size: 28px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(180, 180, 180);
}

.rematch-ready {
    color: rgb(100, 255, 100);
}

/* ===========================================
   Buttons
   =========================================== */

.action-button {
    font-size: 42px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    -unity-text-align: middle-center;
    border-radius: 10px;
    border-width: 0;
    height: 80px;
    padding: 0 30px;
    color: rgb(255, 255, 255);
}

.primary-button {
    background-color: rgba(50, 150, 255, 0.7);
    color: rgb(255, 255, 255);
    transition-duration: 0.15s;
}

.primary-button:hover {
    background-color: rgba(70, 170, 255, 0.9);
}

.primary-button:active {
    background-color: rgba(40, 130, 220, 0.9);
    scale: 0.98;
}

.primary-button:disabled {
    background-color: rgba(50, 150, 255, 0.3);
    color: rgba(255, 255, 255, 0.5);
}

.secondary-button {
    background-color: rgba(100, 100, 100, 0.7);
    color: rgb(255, 255, 255);
    transition-duration: 0.15s;
}

.secondary-button:hover {
    background-color: rgba(120, 120, 120, 0.9);
}

.secondary-button:active {
    background-color: rgba(80, 80, 80, 0.8);
    scale: 0.98;
}

.secondary-button:disabled {
    background-color: rgba(100, 100, 100, 0.3);
    color: rgba(255, 255, 255, 0.5);
}

/* ===========================================
   Footer
   =========================================== */

#Footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 0 2% 2% 2%;
}

#NavigationButtons {
    flex-direction: row;
}

#PlayAgainSection {
    flex-direction: row;
}

.footer-button {
    width: 400px;
    height: 100px;
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    background-color: rgba(100, 100, 100, 0.7);
    border-radius: 10px;
    border-width: 0;
    color: rgb(255, 255, 255);
    margin-right: 15px;
    transition-duration: 0.15s;
}

.footer-button:hover {
    background-color: rgba(120, 120, 120, 0.9);
}

.footer-button:active {
    background-color: rgba(80, 80, 80, 0.8);
    scale: 0.98;
}

.footer-button:disabled {
    background-color: rgba(100, 100, 100, 0.3);
    color: rgba(255, 255, 255, 0.5);
}

.footer-button.primary-button {
    background-color: rgba(50, 150, 255, 0.7);
}

.footer-button.primary-button:hover {
    background-color: rgba(70, 170, 255, 0.9);
}

.footer-button.primary-button:active {
    background-color: rgba(40, 130, 220, 0.9);
    scale: 0.98;
}

.footer-button.primary-button:disabled {
    background-color: rgba(50, 150, 255, 0.3);
}

/* ===========================================
   Vote Section
   =========================================== */

#VoteSection {
    flex-direction: column;
    align-items: flex-end;
}

#VoteStatusContainer {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

#VoteButtons {
    flex-direction: row;
}

/* ===========================================
   Player Left Indicator
   =========================================== */

.player-row-left {
    opacity: 0.4;
    background-color: rgba(100, 100, 100, 0.2);
}

/* NOTE: ::after pseudo-element is not supported in Unity UI Toolkit.
   Add "(Left)" text in C# code when player has left. */

.status-left {
    color: rgb(255, 150, 100);
}

/* Vote status in leaderboard */
.status-voted {
    color: rgb(100, 200, 255);
}

.status-not-voted {
    color: rgb(180, 180, 180);
}

/* ===========================================
   Host Left Notification Overlay
   =========================================== */

.notification-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
}

.notification-panel {
    background-color: rgba(50, 50, 50, 0.95);
    padding: 60px 100px;
    border-radius: 20px;
    border-width: 3px;
    border-color: rgb(255, 100, 100);
    align-items: center;
}

.notification-title {
    font-size: 64px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 100, 100);
    margin-bottom: 20px;
}

.notification-message {
    font-size: 42px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(200, 200, 200);
}
