/* ===========================================
   Results Scene Stylesheet
   =========================================== */

/* Root Container */
#Root {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
}

/* ===========================================
   Header
   =========================================== */

#Header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 1% 2%;
}

/* Title Label */
#TitleLabel {
    font-size: 96px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Black');
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
}

/* Result Badge */
.result-badge {
    padding: 15px 40px;
    border-radius: 10px;
    border-width: 3px;
}

.result-badge-text {
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Black');
    -unity-text-align: middle-center;
}

/* Result States */
.result-victory .result-badge-text {
    color: rgb(100, 255, 100);
}

.result-victory {
    background-color: rgba(0, 255, 0, 0.2);
    border-color: rgb(100, 255, 100);
}

.result-defeat .result-badge-text {
    color: rgb(255, 100, 100);
}

.result-defeat {
    background-color: rgba(255, 0, 0, 0.2);
    border-color: rgb(255, 100, 100);
}

.result-draw .result-badge-text {
    color: rgb(200, 200, 200);
}

.result-draw {
    background-color: rgba(128, 128, 128, 0.2);
    border-color: rgb(200, 200, 200);
}

/* ===========================================
   Content Area
   =========================================== */

#ContentArea {
    flex-grow: 1;
    flex-direction: row;
    margin: 0 2% 2% 2%;
}

/* Panels */
#LeftPanel, #RightPanel {
    border-radius: 10px;
    padding: 20px;
}

#LeftPanel {
    background-color: rgba(0, 0, 0, 0.5);
    width: 45%;
    margin-right: 2%;
    flex-direction: column;
}

#RightPanel {
    background-color: rgba(0, 0, 0, 0.7);
    width: 53%;
    flex-direction: column;
}

/* Panel Titles */
.panel-title {
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
    margin-bottom: 20px;
}

/* Section Headers */
.section-header {
    font-size: 48px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(220, 220, 220);
    margin-bottom: 15px;
}

/* ===========================================
   Score Section
   =========================================== */

.score-box {
    align-items: center;
    padding: 20px 40px;
    border-radius: 10px;
    min-width: 150px;
}

.player-score {
    background-color: rgba(100, 150, 255, 0.3);
    border-width: 2px;
    border-color: rgb(100, 150, 255);
}

.enemy-score {
    background-color: rgba(255, 100, 100, 0.3);
    border-width: 2px;
    border-color: rgb(255, 100, 100);
}

.score-team-label {
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(200, 200, 200);
    margin-bottom: 10px;
}

.score-value {
    font-size: 96px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Black');
    color: rgb(255, 255, 255);
}

.score-separator {
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(180, 180, 180);
    margin: 0 30px;
}

/* ===========================================
   Detail Rows
   =========================================== */

.detail-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.detail-label {
    font-size: 36px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(180, 180, 180);
    width: 200px;
}

.detail-value {
    font-size: 36px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(255, 255, 255);
    flex-grow: 1;
}

/* ===========================================
   Stats Grid
   =========================================== */

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.stat-item {
    width: 30%;
    align-items: center;
    margin-bottom: 25px;
    padding: 15px 10px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
}

.stat-label {
    font-size: 28px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(180, 180, 180);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.stat-value {
    font-size: 48px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(255, 255, 255);
}

/* ===========================================
   Replay Section
   =========================================== */

.replay-saved-badge {
    background-color: rgba(100, 200, 100, 0.3);
    padding: 10px 20px;
    border-radius: 8px;
    margin-right: 15px;
    border-width: 2px;
    border-color: rgb(100, 200, 100);
}

.badge-text {
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    color: rgb(100, 255, 100);
}

/* ===========================================
   Buttons
   =========================================== */

.action-button {
    font-size: 42px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Bold');
    -unity-text-align: middle-center;
    border-radius: 10px;
    border-width: 0;
    height: 80px;
}

.primary-button {
    background-color: rgba(50, 150, 255, 0.7);
    color: rgb(255, 255, 255);
}

.primary-button:hover {
    background-color: rgba(70, 170, 255, 0.9);
}

.secondary-button {
    background-color: rgba(100, 100, 100, 0.7);
    color: rgb(255, 255, 255);
}

.secondary-button:hover {
    background-color: rgba(120, 120, 120, 0.9);
}

.footer-button {
    width: 400px;
    height: 100px;
    font-size: 56px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    background-color: rgba(100, 100, 100, 0.7);
    border-radius: 10px;
    border-width: 0;
    color: rgb(255, 255, 255);
}

.footer-button:hover {
    background-color: rgba(120, 120, 120, 0.9);
}

.footer-button.primary-button {
    background-color: rgba(50, 150, 255, 0.7);
}

.footer-button.primary-button:hover {
    background-color: rgba(70, 170, 255, 0.9);
}

/* ===========================================
   Rematch Section
   =========================================== */

.rematch-status-label {
    font-size: 32px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(255, 200, 100);
    margin-bottom: 5px;
}

.rematch-count-label {
    font-size: 28px;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(180, 180, 180);
}

.rematch-ready {
    color: rgb(100, 255, 100);
}
